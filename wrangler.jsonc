{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fashshotit",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		// Serve index.html for client-side routes like /work/real-estate
		"not_found_handling": "single-page-application",
		// Only API requests hit the Worker; static pages and social sharing HTML are served directly from the CDN at zero worker cost
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fashshotit-db",
			"database_id": "233e5dd0-8e70-4069-9d58-88a105fa782e",
			"remote": true
		}
	],
	"vars": {
		// Comma-separated list of inboxes that receive contact form submissions
		"CONTACT_TO": "media@fashshotit.com,fashshotitmedia@gmail.com",
		// Must be an address on a domain verified with Resend
		"CONTACT_FROM": "Fash Shot It <noreply@fashshotit.com>",
		// Wrapp celebration kit URL for UNILAG convocation bookings
		"WRAPP_KIT_URL": "https://sandbos-app.wrapp.ng/kit/up5jpqap"
	},
	// Preview builds (one per non-production branch). Vars aren't inherited from above,
	// so test enquiries go to one inbox and are clearly labelled as previews.
	"previews": {
		"vars": {
			"CONTACT_TO": "fashshotitmedia@gmail.com",
			"CONTACT_FROM": "Fash Shot It Preview <noreply@fashshotit.com>",
			"WRAPP_KIT_URL": "https://sandbos-app.wrapp.ng/kit/up5jpqap"
		}
	}
	// Secrets (set with `npx wrangler secret put <NAME>`):
	//   RESEND_API_KEY
	//   PAYSTACK_SECRET_KEY
}
